---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  forceState?: 'normal' | 'hover' | 'focus' | 'active';
  type?: 'button' | 'submit' | 'reset';
  href?: string;
}
const { variant = 'primary', size = 'md', disabled = false, forceState = 'normal', type = 'button', href } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag
  href={!disabled ? href : undefined}
  tabindex={disabled && href ? -1 : undefined}
  type={!href ? type : undefined}
  disabled={!href ? disabled : undefined}
  aria-disabled={disabled ? 'true' : undefined}
  class:list={['ui-button', 'ui-button--' + variant, 'ui-button--' + size, forceState !== 'normal' && 'ui-button--force-' + forceState]}
><slot /></Tag>
