---
interface Props { variant?: 'neutral' | 'accent' | 'success' | 'warning'; mono?: boolean; }
const { variant = 'neutral', mono = true } = Astro.props;
---
<span class:list={['ui-badge', 'ui-badge--' + variant, mono && 'ui-badge--mono']}>
  {(variant === 'success' || variant === 'warning' || variant === 'accent') && <span class="ui-badge__dot" aria-hidden="true"></span>}
  <slot />
</span>
