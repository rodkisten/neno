---
interface Props { href?: string; variant?: 'primary' | 'secondary'; external?: boolean; ariaLabel?: string; }
const { href, variant = 'primary', external = false, ariaLabel } = Astro.props;
---
{href ? (
  <a href={href} aria-label={ariaLabel} class:list={['neo-button', variant === 'secondary' && 'neo-button--secondary']}
     target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
    <span><slot /></span><span class="neo-button__arrow" aria-hidden="true">↗</span>
  </a>
) : (
  <button type="button" class:list={['neo-button', variant === 'secondary' && 'neo-button--secondary']}>
    <span><slot /></span><span class="neo-button__arrow" aria-hidden="true">↗</span>
  </button>
)}
