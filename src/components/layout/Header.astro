---
import MobileMenu from './MobileMenu.astro';
import ThemeSwitcher from '../ui/ThemeSwitcher.astro';
const navItems = [
  { code: '01', label: 'Projetos', href: '/#projetos' },
  { code: '02', label: 'Game Lab', href: '/#game-lab' },
  { code: '03', label: 'Trajetória', href: '/#experiencia' },
  { code: '04', label: 'Journal', href: '/#journal' },
  { code: '05', label: 'Stack', href: '/#competencias' },
  { code: '06', label: 'Contato', href: '/#contato' },
];
---
<header class="neo-topbar">
  <div class="neo-container neo-topbar__inner">
    <a href="/" class="neo-brand" aria-label="Juan Silva Garcia, página inicial">
      <span class="neo-brand__mark" aria-hidden="true">J</span>
      <span>JUAN<span class="hidden sm:inline"> / GARCIA</span></span>
    </a>
    <nav class="neo-nav" aria-label="Navegação principal">
      {navItems.map((item) => <a href={item.href}><span class="neo-nav__number">{item.code}</span>{item.label}</a>)}
    </nav>
    <div class="neo-tools">
      <ThemeSwitcher />
      <MobileMenu items={navItems} />
    </div>
  </div>
</header>
