---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ThemeShowcase from '../components/ui/ThemeShowcase.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
const palette = [
  { name: 'ACID', token: '--color-acid', css: 'var(--color-acid)' },
  { name: 'CYAN', token: '--color-cyan', css: 'var(--color-cyan)' },
  { name: 'PINK', token: '--color-pink', css: 'var(--color-pink)' },
  { name: 'ORANGE', token: '--color-orange', css: 'var(--color-orange)' },
  { name: 'YELLOW', token: '--color-yellow', css: 'var(--color-yellow)' },
  { name: 'VIOLET', token: '--color-violet', css: 'var(--color-violet)' },
];
const motion = [
  ['FAST', '--motion-fast', '160ms'],
  ['BASE', '--motion-base', '320ms'],
  ['SLOW', '--motion-slow', '700ms'],
  ['EASING', '--ease-out-expo', 'cubic-bezier(0.19, 1, 0.22, 1)'],
  ['PARALLAX', '--parallax-medium', '0.18'],
  ['TILT', '--tilt-max', '8deg'],
];
---
<BaseLayout title="Design System — NEO-MANGA / Juan Silva Garcia" description="Guia vivo de tokens, temas, tipografia, componentes e motion do portfólio NEO-MANGA.">
  <div class="neo-site">
    <Header />
    <main class="neo-catalog neo-container" id="main-content" tabindex="-1">
      <span class="neo-label">DESIGN SYSTEM / 01.0</span>
      <h1 class="neo-catalog__title">NEO-MANGA.<br /><span class="neo-outline">UI SYSTEM.</span></h1>
      <p class="neo-text" style="margin-top:1.5rem">Três paletas. Um sistema de componentes. Motion progressivo, sem bloquear a leitura. Troque o preset ou o modo de cor no cabeçalho.</p>
      <section class="neo-catalog__section" aria-labelledby="palette-heading">
        <h2 id="palette-heading">01 / CORES.</h2>
        <div class="neo-swatches">
          {palette.map((color) => <div class="neo-swatch" style={'--swatch:' + color.css}><strong>{color.name}</strong><span>{color.token}</span></div>)}
        </div>
        <p class="neo-caption" style="margin-top:1.5rem">PRESETS: ACID POP / CYBER ARCADE / MONO ELECTRIC. TUDO EDITÁVEL EM src/styles/global.css.</p>
      </section>
      <section class="neo-catalog__section" aria-labelledby="type-heading">
        <h2 id="type-heading">02 / TIPOGRAFIA.</h2>
        <div class="neo-catalog__sample">
          <span class="neo-caption">DISPLAY / ANTON</span>
          <p class="neo-heading">VISUAL.<br /><span class="neo-outline">SYSTEM.</span></p>
          <div class="neo-catalog__grid" style="margin-top:2rem">
            <p style="font:700 clamp(1.4rem,3vw,3rem)/1.2 var(--font-sans)">Space Grotesk<br />Interface & conteúdo</p>
            <p style="font:600 .8rem/1.8 var(--font-mono)">IBM Plex Mono<br />HUD / LABELS / IDENTIFICADORES<br />0123456789</p>
          </div>
        </div>
      </section>
      <section class="neo-catalog__section" aria-labelledby="component-heading">
        <h2 id="component-heading">03 / COMPONENTES.</h2>
        <div class="neo-catalog__sample neo-catalog__components">
          <Button>BOTÃO PRIMÁRIO ↗</Button>
          <Button variant="secondary">SECUNDÁRIO ↗</Button>
          <Button variant="ghost">AÇÃO DISCRETA</Button>
          <Badge variant="neutral">SISTEMA</Badge>
          <Badge variant="accent">EM FOCO</Badge>
          <Badge variant="success">ATIVO</Badge>
          <Badge variant="warning">ATENÇÃO</Badge>
        </div>
      </section>
      <section class="neo-catalog__section" aria-labelledby="showcase-heading">
        <h2 id="showcase-heading">04 / ESTADOS & CONTROLES.</h2>
        <ThemeShowcase themeTitle="NEO-MANGA / COMPONENT SHOWCASE" themeSubtitle="Componentes reais do projeto: navegação, abas, controles, indicadores e laboratório interativo." />
      </section>
      <section class="neo-catalog__section" aria-labelledby="motion-heading">
        <h2 id="motion-heading">05 / MOTION.</h2>
        <div class="neo-catalog__grid">
          {motion.map((item) => <div class="neo-catalog__sample"><span class="neo-caption">{item[0]}</span><p style="margin-top:.5rem;font:600 .84rem/1.6 var(--font-mono)">{item[1]}</p><strong>{item[2]}</strong></div>)}
        </div>
        <p class="neo-text" style="margin-top:1.5rem">Scroll e parallax usam a API nativa de animação do navegador. O conteúdo permanece legível com JavaScript indisponível ou movimento reduzido.</p>
      </section>
      <a href="/" class="neo-button neo-button--secondary"><span>VOLTAR AO PORTFÓLIO</span><span class="neo-button__arrow" aria-hidden="true">↗</span></a>
    </main>
    <Footer />
  </div>
</BaseLayout>
