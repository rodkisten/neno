---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ArcadeButton from '../components/ui/ArcadeButton.astro';

const projects = [
  {
    code: 'PRJ-01',
    category: 'PROJETO FREELANCE // ENGENHARIA WEB',
    status: 'EM PRODUÇÃO',
    statusVariant: 'success' as const,
    title: 'Lundgren Atelier — Plataforma Digital em Produção',
    summary:
      'Desenvolvimento completo e publicação de website comercial em produção, integrando Astro, Sanity.io (Headless CMS), estilização com Tailwind CSS, scripts automatizados em Node.js para migração de acervo e deploy contínuo via Cloudflare Pages.',
    metrics: 'Em Produção • Astro + Sanity.io + Cloudflare Pages',
    stack: ['Astro', 'Sanity.io (Headless CMS)', 'Tailwind CSS', 'Node.js (Scripts de Migração)', 'Cloudflare Pages'],
    links: [{ label: 'Acessar Site Oficial ↗', href: 'https://lundgren-atelier.com/', external: true }],
  },
  {
    code: 'PRJ-02',
    category: 'PESQUISA CIENTÍFICA // BIOACÚSTICA & IA',
    status: 'PUBLICADO (VII CoBICET)',
    statusVariant: 'accent' as const,
    title: 'Detecção Acústica de Aves Ameaçadas Utilizando Aprendizado de Máquina',
    summary:
      'Trabalho Completo publicado nos Anais do VII CoBICET (05/08/2026, Editora Even3) e apresentado no XVIII EAMC (2026), em coautoria com Maurício Archanjo Nunes Coelho. Investigação sobre 136 espécies ameaçadas (Xeno-Canto) com Espectrogramas Mel e MFCC, comparando SVM (MVS), GMM-HMM (MOM) e CNN (RNC) entre o Cenário A (Controle) e o Cenário B (Proposto).',
    metrics: 'CNN F1-weighted: 0,82 (~82% Acurácia) • ISSN 2764-0582',
    stack: ['Python', 'CNN (RNC)', 'SVM (MVS)', 'GMM-HMM (MOM)', 'Espectrogramas Mel & MFCC', 'Xeno-Canto (136 espécies)'],
    links: [{ label: 'Ver Registro no Lattes ↗', href: 'http://lattes.cnpq.br/9434044887106048', external: true }],
  },
  {
    code: 'PRJ-03',
    category: 'PROJETO ACADÊMICO // EXTENSÃO & MOBILE',
    status: 'CONCLUÍDO (2024–2026)',
    statusVariant: 'accent' as const,
    title: 'ShapeMeApp — Monitoramento de Carga e Evolução na Musculação',
    summary:
      'Aplicativo mobile Android desenvolvido no ciclo de extensão 2024–2026 (IF Sudeste MG — Campus Rio Pomba) para alunos, professores e coordenação, com cálculo de Carga Interna de Treinamento (CIT), Monotonia e Strain. Estudo apresentado no VII SIMEPE (2025) em coautoria com Gustavo Vaz Teixeira, Sérgio Muinhos Barroso Lima e João Batista Ferreira Júnior.',
    metrics: 'Apresentado no VII SIMEPE (2025) • CIT, Monotonia & Strain',
    stack: ['React Native', 'Expo SDK', 'Firebase Auth', 'Cloud Firestore', 'AsyncStorage', 'QA & Usabilidade'],
    links: [{ label: 'Referência Acadêmica ↗', href: 'http://lattes.cnpq.br/9434044887106048', external: true }],
  },
  {
    code: 'PRJ-04',
    category: 'PROJETO AUTORAL // GAME DEVELOPMENT LAB',
    status: 'EM DESENVOLVIMENTO',
    statusVariant: 'neutral' as const,
    title: 'Núcleo Selvagem — Roguelite de Criaturas Mutantes',
    summary:
      'Projeto autoral de jogo roguelite com sistema de expedições, evolução genética de criaturas mutantes e Base Pessoal 2.0, desenvolvido com arquitetura modular em Luau no Roblox Studio e modelagem 3D autoral no Blender.',
    metrics: 'Expedições, Evolução Genética & Base Pessoal 2.0',
    stack: ['Roblox Studio', 'Luau', 'Blender (Modelagem 3D)', 'Arquitetura Modular', 'Sistemas Roguelite'],
    links: [{ label: 'Inspecionar no Game Lab ↓', href: '#game-lab', external: false }],
  },
];

const experiences = [
  {
    period: '04/2026 — ATUAL',
    role: 'Professor Tutor',
    org: 'CNA Digital',
    tag: 'ENSINO DE PROGRAMAÇÃO, 3D, JOGOS & IA (15H/SEM)',
    description:
      'Atuação como professor de programação conduzindo trilhas técnicas de lógica, Scratch, Construct, modelagem 3D com Blender e SculptGL, Unity, Roblox Studio, React, Python, Ciência de Dados e Inteligência Artificial.',
  },
  {
    period: '06/2025 — ATUAL',
    role: 'Professor Tutor',
    org: 'Kodland',
    tag: 'EDTECH INTERNACIONAL • PYTHON, LUA & SCRATCH (12H/SEM)',
    description:
      'Ensino de programação para alunos de 8 a 16 anos em Scratch, Python (incluindo Flask, POO e bancos de dados) e Roblox Studio/Lua, aplicando metodologia PBL (Project-Based Learning), Scrum e versionamento com Git/GitHub.',
  },
  {
    period: '06/2025 — 06/2026',
    role: 'Pesquisador em Inteligência Artificial',
    org: 'IF Sudeste MG — Campus Rio Pomba',
    tag: 'PESQUISA CIENTÍFICA PUBLICADA (VII CoBICET & XVIII EAMC)',
    description:
      'Desenvolvimento de sistema e modelos de aprendizado de máquina para identificação automática de 136 espécies de aves ameaçadas de extinção, comparando RNC/CNN, MVS/SVM e MOM/HMM entre o Cenário A (Controle) e o Cenário B (Proposto).',
  },
  {
    period: '09/2025 — 01/2026',
    role: 'Desenvolvedor Java',
    org: 'IF Sudeste MG — Campus Rio Pomba',
    tag: 'ENGENHARIA DE SOFTWARE & PERSISTÊNCIA RELACIONAL',
    description:
      'Engenharia de software com levantamento de requisitos, modelagem em diagramas UML, Programação Orientada a Objetos em Java, persistência com JPA/PostgreSQL e autenticação segura com BCrypt.',
  },
  {
    period: '08/2024 — 01/2026',
    role: 'Desenvolvedor Mobile Júnior — Projeto ShapeMeApp',
    org: 'IF Sudeste MG — Campus Rio Pomba',
    tag: 'EXTENSÃO TECNOLÓGICA • REACT NATIVE & FIREBASE',
    description:
      'Atuação no projeto de extensão "Emagreça na Musculação no IF Sudeste MG - Campus Rio Pomba" (ShapeMeApp), realizando QA, testes de usabilidade, evolução mobile em React Native/Expo, modelagem NoSQL no Firebase e gestão ágil com Jira e GitHub.',
  },
  {
    period: '06/2022 — 11/2025',
    role: 'Membro de Projetos / Validação e Prototipação',
    org: 'EmComp — Empresa Júnior de Computação (IF Sudeste MG)',
    tag: 'EMPRESA JÚNIOR • 100 HORAS CERTIFICADAS',
    description:
      'Atuação no desenvolvimento do site da Labclin, prototipação de sites e aplicativos, validação de UX/UI e organização de eventos técnicos junto ao Núcleo da Mata.',
  },
];

const complementaryActivities = [
  {
    period: '03/2025 — 08/2025',
    title: 'Monitor Voluntário de Linguagens Formais e Autômatos',
    detail: 'IF Sudeste MG — Apoio acadêmico em autômatos, gramáticas e teoria da computação.',
  },
  {
    period: '2025',
    title: 'Ministrante de Minicurso Presencial: React com Firebase',
    detail: 'IF Sudeste MG — Capacitação prática em interfaces reativas e integração em nuvem.',
  },
  {
    period: '12/2023 — 08/2024',
    title: 'Instrutor de Desenvolvimento Mobile (JavaScript & React Native)',
    detail: 'IF Sudeste MG — Produção e gravação de 16 videoaulas técnicas sobre desenvolvimento mobile.',
  },
  {
    period: '2020',
    title: 'Voluntário no Curso "Python Básico pra Quem Tem Pressa"',
    detail: 'IF Sudeste MG — Apoio na introdução prática à lógica e programação em Python.',
  },
];

const journalPreviews = [
  {
    code: 'CADERNO-01',
    category: 'PESQUISA EM IA & SINAIS',
    title: 'Espectrogramas Mel e MFCC na Classificação de 136 Espécies Ameaçadas: Cenário A vs. Cenário B',
    excerpt:
      'Análise técnica comparando SVM (MVS), GMM-HMM (MOM) e CNN (RNC) sobre áudios do Xeno-Canto entre o Cenário A (Controle) e o Cenário B (Proposto), no qual a CNN atingiu F1-weighted de 0,82 (~82% de acurácia).',
    meta: 'Publicado nos Anais do VII CoBICET (ISSN 2764-0582) e XVIII EAMC (2026)',
  },
  {
    code: 'CADERNO-02',
    category: 'ENGENHARIA MOBILE & EXTENSÃO',
    title: 'Evolução de Software em Ambientes Acadêmicos: ShapeMeApp, CIT, Monotonia e Strain',
    excerpt:
      'Arquitetura em React Native, Expo SDK, Firebase Auth, Cloud Firestore e AsyncStorage para acompanhamento de alunos, professores e coordenação a partir de feedbacks reais de usabilidade.',
    meta: 'Apresentado no VII SIMEPE (2025) — IF Sudeste MG',
  },
  {
    code: 'CADERNO-03',
    category: 'ENGENHARIA WEB & GAME SYSTEMS',
    title: 'Migração Headless com Astro + Sanity.io e Sistemas Roguelite em Luau/Blender',
    excerpt:
      'Decisões práticas de engenharia na entrega comercial do Lundgren Atelier em Cloudflare Pages e na arquitetura de expedições, evolução genética e Base Pessoal 2.0 do Núcleo Selvagem.',
    meta: 'Notas de Arquitetura — Produção Web & Game Dev Lab',
  },
];

const skillGroups = [
  {
    title: 'Linguagens & Backend',
    code: 'GRP-01',
    items: [
      'Python (Flask / POO / Dados)',
      'TypeScript & JavaScript',
      'Java (POO / JPA / BCrypt)',
      'Luau / Lua (Roblox Studio)',
      'SQL & PostgreSQL',
      'Modelagem UML & Requisitos',
    ],
  },
  {
    title: 'Engenharia Web & Mobile',
    code: 'GRP-02',
    items: [
      'React Native & Expo SDK',
      'React',
      'Astro & Tailwind CSS',
      'Sanity.io (Headless CMS)',
      'Node.js',
      'Firebase (Auth / Firestore) & AsyncStorage',
      'Cloudflare Pages',
    ],
  },
  {
    title: 'IA, Ciência de Dados & Bioacústica',
    code: 'GRP-03',
    items: [
      'Redes Neurais Convolucionais (CNN / RNC)',
      'Máquinas de Vetores de Suporte (SVM / MVS)',
      'Modelos Ocultos de Markov (GMM-HMM / MOM)',
      'Espectrogramas Mel & MFCC',
      'Base Xeno-Canto (136 espécies)',
      'Ciência de Dados & IA',
    ],
  },
  {
    title: 'Game Dev, 3D & Metodologias',
    code: 'GRP-04',
    items: [
      'Roblox Studio & Unity',
      'Blender & SculptGL (Modelagem 3D)',
      'Scratch & Construct',
      'Git, GitHub & Jira',
      'Scrum, QA & Testes de Usabilidade',
      'Metodologia PBL (Ensino de Tecnologia)',
    ],
  },
];
---

<BaseLayout
  title="Juan Silva Garcia — Engenharia, Pesquisa em IA e Game Systems"
  description="Portfólio de Juan Silva Garcia: engenharia web e mobile, pesquisa em bioacústica com IA, ensino de programação e desenvolvimento de jogos."
>
  <div class="neo-site">
    <Header />
    <main id="main-content" tabindex="-1">
      <!-- 00 / Cinematic opening -->
      <section class="neo-hero" aria-labelledby="hero-heading">
        <div class="neo-hero__grid" aria-hidden="true"></div>
        <div class="neo-container neo-hero__inner">
          <div class="neo-hero__intro">
            <span class="neo-hero__eyebrow hud-text">JUAN SILVA GARCIA / SOFTWARE & AI</span>
            <h1 id="hero-heading" class="neo-hero__title">
              <span class="line-pop">CÓDIGO.</span>
              <span class="line-outline">PESQUISA.</span>
              <span class="line-accent">& JOGOS.</span>
            </h1>
            <p class="neo-hero__description">
              <strong>Engenharia de software, IA e sistemas interativos.</strong>
              Graduando em Ciência da Computação no IF Sudeste MG. Desenvolvimento web, mobile e Java, pesquisa em bioacústica e ensino de programação.
            </p>
            <div class="neo-hero__actions">
              <ArcadeButton href="#projetos">EXPLORAR PROJETOS</ArcadeButton>
              <ArcadeButton href="#contato" variant="secondary">ENTRAR EM CONTATO</ArcadeButton>
            </div>
            <div class="neo-hero__foot">
              <span>RIO POMBA · MG · BRASIL</span>
              <span>IF SUDESTE MG</span>
              <span>↓ ROLE PARA EXPLORAR</span>
            </div>
          </div>
          <div class="neo-hero__art" role="img" aria-label="Grafismo original neo-manga de um rosto geométrico com enquadramento ciano, padrão de linhas e etiquetas coloridas">
            <div class="neo-hero__poster">
              <div class="neo-poster__halftone"></div>
              <div class="neo-poster__circle"></div>
              <div class="neo-poster__slashes"></div>
              <div class="neo-poster__mask"></div>
              <div class="neo-poster__face"></div>
              <div class="neo-poster__eye neo-poster__eye--a"></div>
              <div class="neo-poster__eye neo-poster__eye--b"></div>
              <div class="neo-poster__nose"></div>
              <div class="neo-poster__collar"></div>
            </div>
            <div class="neo-hero__corner">PORTFÓLIO / 2026</div>
            <span class="neo-hero__sticker neo-sticker--one">WEB<br />& IA</span>
            <span class="neo-hero__sticker neo-sticker--two">WEB / MOBILE / IA / GAME</span>
            <span class="neo-hero__vertical" aria-hidden="true">DESIGN × DEVELOPMENT</span>
          </div>
        </div>
      </section>

      <div class="neo-marquee" aria-label="Web, mobile, pesquisa, inteligência artificial e jogos">
        <div class="neo-marquee__track" aria-hidden="true">
          <span>WEB DEVELOPMENT ✳</span><span>ARTIFICIAL INTELLIGENCE ✳</span><span>GAME SYSTEMS ✳</span><span>MOBILE ENGINEERING ✳</span>
          <span>WEB DEVELOPMENT ✳</span><span>ARTIFICIAL INTELLIGENCE ✳</span><span>GAME SYSTEMS ✳</span><span>MOBILE ENGINEERING ✳</span>
        </div>
      </div>

      <!-- 01 / Profile -->
      <section id="apresentacao" class="neo-section" aria-labelledby="apresentacao-heading">
        <span class="neo-section__number" aria-hidden="true">00</span>
        <div class="neo-container neo-profile">
          <div class="js-reveal">
            <span class="neo-label">00 / PERFIL</span>
            <h2 id="apresentacao-heading" class="neo-profile__statement">
              CIÊNCIA.<br /><em>PRÁTICA.</em><br />SOFTWARE.
            </h2>
            <p class="neo-profile__note">
              Juan Silva Garcia (GARCIA, J. S.) integra formação técnica e graduação em Ciência da Computação,
              pesquisa experimental publicada, desenvolvimento web e mobile, Java e jogos autorais.
            </p>
            <a href="http://lattes.cnpq.br/9434044887106048" target="_blank" rel="noopener noreferrer" class="neo-button neo-button--secondary">
              <span>CURRÍCULO LATTES</span><span class="neo-button__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
          <dl class="neo-panel neo-credentials js-reveal">
            <div class="neo-credential">
              <dt>FORMAÇÃO / 01</dt>
              <dd>Bacharelado em Ciência da Computação (2022–2026)<small>Em andamento · IF Sudeste MG, Campus Rio Pomba</small></dd>
            </div>
            <div class="neo-credential">
              <dt>FORMAÇÃO / 02</dt>
              <dd>Técnico em Informática (2019–2021)<small>Lattes: 2019–2022 · IF Sudeste MG, Campus Rio Pomba</small></dd>
            </div>
            <div class="neo-credential">
              <dt>PESQUISA / 03</dt>
              <dd>VII CoBICET · XVIII EAMC · VII SIMEPE<small>2026 / 2026 / 2025 · Coautoria científica e extensão</small></dd>
            </div>
            <div class="neo-credential">
              <dt>REGISTRO / 04</dt>
              <dd>Trabalho completo, Editora Even3<small>05/08/2026 · ISSN 2764-0582 · Lattes CNPq</small></dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- 02 / Four real projects -->
      <section id="projetos" class="neo-section neo-section--projects" aria-labelledby="projetos-heading">
        <span class="neo-section__number" aria-hidden="true">01</span>
        <div class="neo-container">
          <div class="neo-section__heading js-reveal">
            <div><span class="neo-label">01 / TRABALHOS SELECIONADOS</span><h2 id="projetos-heading" class="neo-heading">PROJETOS<br />EM FOCO.</h2></div>
            <p class="neo-section__sub">Quatro frentes reais. Web em produção, pesquisa publicada, aplicativo mobile e desenvolvimento de jogos.</p>
          </div>
          <div class="neo-projects">
            {projects.map((project, index) => (
              <article class="neo-project js-reveal" data-tilt>
                <div class="neo-project__art" aria-hidden="true">
                  <span class="neo-project__corner">{project.code}</span>
                  <span class="neo-project__glyph">{String(index + 1).padStart(2, '0')}</span>
                  <span class="neo-project__status">{project.status}</span>
                </div>
                <div class="neo-project__body">
                  <span class="neo-caption">{project.category}</span>
                  <h3>{project.title}</h3>
                  <p>{project.summary}</p>
                  <div class="neo-tag-list" aria-label="Tecnologias">
                    {project.stack.map((tech) => <span class="neo-tag">{tech}</span>)}
                  </div>
                  <details class="neo-project__details">
                    <summary>INDICADORES E CONTEXTO</summary>
                    <p>{project.metrics}</p>
                  </details>
                  {project.links.map((link) => (
                    <a class="neo-project__link" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
                      <span>{link.label}</span><span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 03 / Pinned arcade sequence on desktop, regular content on mobile -->
      <section id="game-lab" class="neo-section neo-section--game" aria-labelledby="gamelab-heading">
        <div class="neo-container">
          <div class="neo-game__intro js-reveal">
            <div><span class="neo-label">02 / GAME DEVELOPMENT LAB</span><h2 id="gamelab-heading" class="neo-heading">NÚCLEO<br />SELVAGEM.</h2></div>
            <p class="neo-text">
              Roguelite autoral de criaturas mutantes, em desenvolvimento. Expedições, evolução genética e Base Pessoal 2.0,
              com programação modular em Luau no Roblox Studio e modelagem 3D no Blender.
            </p>
          </div>
          <div class="neo-game__scene">
            <div class="neo-game__visual" role="img" aria-label="Emblema geométrico original que muda de forma durante a navegação da sequência de sistemas do jogo">
              <div class="neo-game__readout"><span>LAB / SYSTEM MAP</span><span>IN DEVELOPMENT</span></div>
              <div class="neo-game__shape" data-stage="0"></div>
              <span class="neo-game__visual-label" aria-hidden="true">NS / 01</span>
            </div>
            <div class="neo-game__chapters">
              <article class="neo-game__chapter" data-active="true">
                <span class="neo-label">SYS-01 / EXPEDIÇÕES ROGUELITE</span>
                <h3>INCURSÃO & PROGRESSÃO</h3>
                <p>Partidas de risco e recompensa, coleta de recursos genéticos e retorno estratégico para evolução contínua.</p>
              </article>
              <article class="neo-game__chapter" data-active="false">
                <span class="neo-label">SYS-02 / EVOLUÇÃO GENÉTICA</span>
                <h3>MUTAÇÕES & ATRIBUTOS</h3>
                <p>Sistema modular em Luau para combinações genéticas, adaptação morfológica e sinergias de combate, com modelos autorais no Blender.</p>
              </article>
              <article class="neo-game__chapter" data-active="false">
                <span class="neo-label">SYS-03 / BASE PESSOAL 2.0</span>
                <h3>PERSISTÊNCIA & ESTADO</h3>
                <p>Arquitetura para estruturas, incubação e manutenção do estado entre sessões no Roblox Studio.</p>
              </article>
              <ArcadeButton href="#contato">SOLICITAR DEMONSTRAÇÃO TÉCNICA</ArcadeButton>
            </div>
          </div>
        </div>
      </section>

      <!-- 04 / Career -->
      <section id="experiencia" class="neo-section neo-section--journey" aria-labelledby="experiencia-heading">
        <div class="neo-container">
          <div class="neo-section__heading js-reveal">
            <div><span class="neo-label">03 / EXPERIÊNCIA & ENSINO</span><h2 id="experiencia-heading" class="neo-heading">TRAJETÓRIA.</h2></div>
            <p class="neo-section__sub">Engenharia, pesquisa aplicada e educação em programação. Registros de 2022 a 2026.</p>
          </div>
          <div class="neo-timeline">
            {experiences.map((exp) => (
              <article class="neo-timeline__item js-reveal">
                <span class="neo-timeline__time">{exp.period}<br /><span class="neo-caption">{exp.tag}</span></span>
                <div><h3>{exp.role}</h3><p class="neo-timeline__org">{exp.org}</p></div>
                <p>{exp.description}</p>
              </article>
            ))}
          </div>
          <details class="neo-extra">
            <summary>FORMAÇÃO COMPLEMENTAR + <span class="neo-caption">IF SUDESTE MG</span></summary>
            <div class="neo-extra__grid">
              {complementaryActivities.map((act) => <div class="neo-extra__item">
                <span class="neo-caption">{act.period}</span><strong>{act.title}</strong><p>{act.detail}</p>
              </div>)}
            </div>
          </details>
        </div>
      </section>

      <!-- 05 / Editorial journal previews -->
      <section id="journal" class="neo-section neo-section--journal" aria-labelledby="journal-heading">
        <div class="neo-container">
          <div class="neo-section__heading js-reveal">
            <div><span class="neo-label">04 / CADERNOS TÉCNICOS</span><h2 id="journal-heading" class="neo-heading">JOURNAL.</h2></div>
            <p class="neo-section__sub">Prévias editoriais de estudos e anotações técnicas. Publicação de artigos completos planejada para uma fase posterior.</p>
          </div>
          <div class="neo-journal">
            {journalPreviews.map((entry, index) => <article class="neo-journal__entry js-reveal">
              <div class="neo-caption">{entry.code} / {entry.category}</div>
              <span class="neo-journal__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{entry.title}</h3>
              <p>{entry.excerpt}</p>
              <small>{entry.meta}</small>
            </article>)}
          </div>
        </div>
      </section>

      <!-- 06 / Skills -->
      <section id="competencias" class="neo-section neo-section--skills" aria-labelledby="competencias-heading">
        <div class="neo-container">
          <div class="neo-section__heading js-reveal">
            <div><span class="neo-label">05 / FERRAMENTAS</span><h2 id="competencias-heading" class="neo-heading">STACK.</h2></div>
            <p class="neo-section__sub">Tecnologias e métodos organizados por domínio de atuação.</p>
          </div>
          <div class="neo-skills">
            {skillGroups.map((group) => <section class="neo-skill js-reveal">
              <div class="neo-skill__head"><h3>{group.title}</h3><span class="neo-caption">{group.code}</span></div>
              <div class="neo-skill__body">{group.items.map((skill) => <span>{skill}</span>)}</div>
            </section>)}
          </div>
        </div>
      </section>

      <!-- 07 / Final CTA -->
      <section id="contato" class="neo-section neo-section--contact" aria-labelledby="contato-heading">
        <div class="neo-container neo-contact">
          <div class="js-reveal">
